# ==============================================================================
# NEXUS AI - Environment Configuration
# ==============================================================================
# Security Notice:
# 1. Never commit production secrets or API keys into version control.
# 2. Public client keys (NEXT_PUBLIC_*) are restricted via Firebase Console & Security Rules.
# 3. Server-side AI secrets must remain without NEXT_PUBLIC_ prefix.
# 4. ₹0 Budget Policy: Never use paid API dependencies.
# ==============================================================================

# Firebase Client Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# AI Provider Configuration (Phase 3 - Free-First ₹0 Budget)
# Primary options: 'gemini' | 'ollama'
AI_PROVIDER=gemini

# Google Gemini API (Free Tier)
# Obtain free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Ollama Local Offline Fallback (http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Meta WhatsApp Business Cloud API (Phase 6 - Free Direct Integration)
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here
WHATSAPP_APP_ID=your_meta_app_id_here
WHATSAPP_APP_SECRET=your_meta_app_secret_here
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_here

# Future Integrations (Phase 7 & Phase 8)
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# X_API_KEY=
# X_API_SECRET=
# N8N_WEBHOOK_URL=

